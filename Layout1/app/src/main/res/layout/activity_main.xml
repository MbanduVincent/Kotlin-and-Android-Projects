<?xml version="1.0" encoding="utf-8"?>

<!--
    This is the main container for the login screen.
    ConstraintLayout allows each item to be positioned using constraints.
    Constraints connect one view to another view or to the parent layout.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!--
        This TextView displays the main title of the screen.
        It is placed at the top center of the layout.
        The text is large and bold to make it look like a heading.
    -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login Form"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        This TextView is the label for the email input field.
        It tells the user that the text box beside it is for entering email.
        A fixed width of 90dp helps align both labels neatly.
    -->
    <TextView
        android:id="@+id/emailLabel"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:text="Email:"
        android:textSize="16sp"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
        This EditText is where the user types their email address.
        It is placed directly beside the Email label.
        The width is 0dp because ConstraintLayout will stretch it
        from the end of the label to the end of the parent layout.
        The inputType is set to textEmailAddress so the keyboard is suitable for email input.
        The background makes the text field visible with a border.
    -->
    <EditText
        android:id="@+id/emailInput"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Enter email"
        android:inputType="textEmailAddress"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="@id/emailLabel"
        app:layout_constraintStart_toEndOf="@id/emailLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        This TextView is the label for the password input field.
        It tells the user that the text box beside it is for entering password.
        It uses the same width as the Email label so the form looks aligned.
    -->
    <TextView
        android:id="@+id/passwordLabel"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:text="Password:"
        android:textSize="16sp"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/emailInput"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
        This EditText is where the user types their password.
        It is placed beside the Password label.
        The inputType is textPassword, which hides the characters typed by the user.
        This is important because passwords should not be openly visible on the screen.
    -->
    <EditText
        android:id="@+id/passwordInput"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Enter password"
        android:inputType="textPassword"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="@id/passwordLabel"
        app:layout_constraintStart_toEndOf="@id/passwordLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        This Button is used to submit the login form.
        It is placed below the password field.
        Its start position is aligned with the input fields,
        so the button lines up neatly with the email and password boxes.
    -->
    <Button
        android:id="@+id/loginButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Login"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf="@id/passwordInput"
        app:layout_constraintStart_toStartOf="@id/emailInput"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>